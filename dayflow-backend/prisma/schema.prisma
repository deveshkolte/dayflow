generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR
  ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveType {
  PAID
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                         String    @id @default(uuid())
  employeeId                 String    @unique
  email                      String    @unique
  passwordHash               String
  role                       Role      @default(EMPLOYEE)
  firstName                  String?
  lastName                   String?
  phone                      String?
  address                    String?
  jobTitle                   String?
  department                 String?
  profilePictureUrl          String?
  isActive                   Boolean   @default(true)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  attendances      Attendance[]
  leaveRequests    LeaveRequest[]    @relation("employeeLeaves")
  approvals        LeaveRequest[]    @relation("approverLeaves")
  salaryStructures SalaryStructure[]
  payrolls         PayrollRecord[]
  documents        Document[]
  auditLogs        AuditLog[]        @relation("actorLogs")

  @@index([role, isActive])
}

model Attendance {
  id         String           @id @default(uuid())
  employee   User             @relation(fields: [employeeId], references: [id])
  employeeId String
  // Prisma uses DateTime here, while PostgreSQL stores only the calendar date.
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus
  notes      String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employee        User        @relation("employeeLeaves", fields: [employeeId], references: [id])
  employeeId      String
  // Leave dates do not need hours, minutes, seconds, or timezone information.
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  type            LeaveType
  status          LeaveStatus @default(PENDING)
  reason          String?
  approver        User?       @relation("approverLeaves", fields: [approverId], references: [id])
  approverId      String?
  approverComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId, status])
  @@index([status, startDate])
}

model SalaryStructure {
  id            String    @id @default(uuid())
  employee      User      @relation(fields: [employeeId], references: [id])
  employeeId    String
  // Monetary value: 12 total digits, with 2 digits after the decimal point.
  baseSalary    Decimal   @db.Decimal(12, 2)
  allowances    Json?
  // Salary effective dates are calendar dates rather than timestamps.
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

model PayrollRecord {
  id          String   @id @default(uuid())
  employee    User     @relation(fields: [employeeId], references: [id])
  employeeId  String
  // Payroll periods are calendar dates; payroll amounts use fixed precision.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  gross       Decimal  @db.Decimal(12, 2)
  net         Decimal  @db.Decimal(12, 2)
  deductions  Json?
  createdAt   DateTime @default(now())

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
}

model Document {
  id         String   @id @default(uuid())
  employee   User     @relation(fields: [employeeId], references: [id])
  employeeId String
  type       String
  url        String
  uploadedAt DateTime @default(now())

  @@index([employeeId, uploadedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     User?    @relation("actorLogs", fields: [actorId], references: [id])
  actorId   String?
  action    String
  entity    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, createdAt])
}
